;; ---------------------------------------------------------------------------
;; G6: RedispatchFunctions.h (torchgen gen.py ComputeRedispatchFunction)
;; ---------------------------------------------------------------------------

(define (compute-redispatch-function f)
  ;; One native function -> the ComputeRedispatchFunction() string.  Unlike
  ;; ComputeFunction this unconditionally emits a function variant (not a
  ;; method) and prepends the dispatchKeySet redispatch argument; there is no
  ;; symint namespace block.
  (let* ((func (native-function-func f))
         (use-const-ref (api:native-function-use-const-ref-context f))
         (use-ilistref (api:native-function-use-ilistref-context f))
         (sigs (api:cpp-signature-group-signatures
                func #t #t (native-function-manual-cpp-binding? f)
                (native-function-cpp-no-default-args f)))
         (target-args (api:dispatcher-signature-arguments func #t use-const-ref
                                                          use-ilistref)))
    (string-concatenate
     (map (lambda (sig)
            (let* ((exprs (api:translate
                           (api:cpp-signature-arguments sig use-const-ref
                                                        use-ilistref)
                           target-args))
                   (exprs-str (string-join
                               (cons "dispatchKeySet" (map api:expr-expr exprs))
                               ", "))
                   (unambiguous (unambiguous-name func)))
              (string-append
               "\n// aten::" (function-schema->string func) "\n"
               "inline "
               (api:cpp-signature-decl sig use-const-ref use-ilistref
                                       #:is-redispatching-fn #t)
               " {\n"
               "    return at::_ops::" unambiguous "::redispatch("
               exprs-str ");\n"
               "}\n")))
          sigs))))

(define %redispatch-functions-template
  (string-append
   "#pragma once\n"
   "\n"
   "// ${generated_comment}\n"
   "\n"
   "#ifdef TORCH_ASSERT_ONLY_METHOD_OPERATORS\n"
   "#error This change adds a dependency on all pytorch operators, meaning the     \\\n"
   "  file will need to be re-compiled every time an operator is changed or added. \\\n"
   "  Consider using the at::_ops::{name}::redispatch() interface by including     \\\n"
   "  the specific operator from <ATen/ops/{my_operator}_ops.h>\n"
   "#endif\n"
   "\n"
   "#include <c10/core/Scalar.h>\n"
   "#include <ATen/Tensor.h>\n"
   "#include <c10/core/Storage.h>\n"
   "#include <ATen/core/Generator.h>\n"
   "#include <c10/util/Deprecated.h>\n"
   "#include <ATen/DeviceGuard.h>\n"
   "#include <c10/core/TensorOptions.h>\n"
   "#include <ATen/core/Reduction.h>\n"
   "#include <optional>\n"
   "#include <ATen/TensorUtils.h>\n"
   "#include <ATen/Context.h>\n"
   "#include <ATen/TracerMode.h>\n"
   "#include <ATen/Operators.h>\n"
   "\n"
   "namespace at {\n"
   "\n"
   "namespace redispatch {\n"
   "    ${function_redispatch_definitions}\n"
   "} // namespace redispatch\n"
   "\n"
   "}\n"))

(define (render-redispatch-functions-h functions)
  (code-template-substitute
   %redispatch-functions-template
   (lambda (key)
     (cond
      ((string=? key "generated_comment")
       (string-append "@generated by " %generator-path
                      " from RedispatchFunctions.h"))
      ((string=? key "function_redispatch_definitions")
       (map compute-redispatch-function functions))
      (else (error 'unknown-template-key key))))))

;; ---------------------------------------------------------------------------
;; G7: NativeFunctions.h (torchgen gen.py get_native_function_declarations +
;; dest/native_functions.py compute_native_function_declaration)
;; ---------------------------------------------------------------------------

;; The frozen first-appearance order of dispatch keys across the default-flag
;; parse of native_functions.yaml.  get_ns_grouped_kernels iterates
;; backend_indices in this order, which fixes the relative order of kernel
;; declarations for an operator that carries kernels under several dispatch
;; keys (e.g. add: CPU before CUDA before NestedTensorCPU ...).  The scheme's
;; own index accumulation is prepend/assoc-set driven and does not reproduce
;; this order, so the canonical list is pinned here.
(define %native-functions-backend-order
  '("CompositeImplicitAutograd" "CompositeExplicitAutograd" "CPU" "CUDA"
    "Meta" "NestedTensorCPU" "NestedTensorHPU" "NestedTensorCUDA"
    "SparseCPU" "SparseCUDA" "SparseCsrCPU" "SparseCsrCUDA" "SparseCsrMeta"
    "SparseMeta" "MkldnnCPU" "ZeroTensor" "QuantizedCPU" "QuantizedCUDA"
    "CompositeExplicitAutogradNonFunctional" "QuantizedMeta"
    "CompositeImplicitAutogradNestedTensor" "NestedTensorMeta"))

(define (native-functions-backend-rank key)
  (or (list-index (lambda (k) (string=? k key))
                  %native-functions-backend-order)
      1000))

(define (native-meta-name group)
  ;; torchgen api/meta.py name(g): str(g.functional.func.name).replace(".", "_")
  (string-replace-all
   (operator-name->string
    (function-schema-name
     (native-function-func (native-functions-group-functional group))))
   "." "_"))

(define (gen-unstructured f backend-index)
  ;; dest/native_functions.py gen_unstructured with external=False.  Returns the
  ;; "TORCH_API {returns} {kernel}({args});" declaration, or #f when there is no
  ;; kernel metadata or the kernel is a legacy:: one.
  (let ((metadata (api:backend-index-get-kernel f backend-index)))
    (if (or (not metadata)
            (string-contains (backend-metadata-kernel metadata) "legacy::"))
        #f
        (let* ((func (native-function-func f))
               (symint (backend-metadata-supports-symint? metadata))
               (use-const-ref (api:native-function-use-const-ref-context f))
               (use-ilistref (api:native-function-use-ilistref-context f)))
          (string-append
           "TORCH_API "
           (api:ctype-cpp-type
            (api:native-signature-returns-type func symint use-const-ref))
           " " (backend-metadata-kernel metadata) "("
           (string-join
            (map api:binding-decl
                 (api:native-signature-arguments func symint use-const-ref
                                                 use-ilistref))
            ", ")
           ");")))))

(define (gen-structured group backend-index metadata)
  ;; dest/native_functions.py gen_structured with external=False: one multi-line
  ;; struct declaration (the surrounding join/split collapses it back to lines).
  (let ((meta-name (native-meta-name group))
        (out-args (api:structured-impl-arguments group)))
    (list
     (string-append
      "struct TORCH_API structured_" (backend-metadata-kernel metadata)
      " : public at::meta::structured_" meta-name " {\n"
      "void impl(" (string-join (map api:binding-decl out-args) ", ")
      ");\n"
      "};\n"))))

(define (compute-native-function-declaration g backend-index)
  ;; dest/native_functions.py compute_native_function_declaration.
  (if (native-functions-group? g)
      (let ((metadata (api:backend-index-get-kernel-group g backend-index)))
        (if (and metadata (backend-metadata-structured metadata))
            (gen-structured g backend-index metadata)
            (append-map
             (lambda (f)
               (let ((decl (gen-unstructured f backend-index)))
                 (if decl (list decl) '())))
             (native-functions-group-functions g))))
      (let ((decl (gen-unstructured g backend-index)))
        (if decl (list decl) '()))))

(define (ordered-backend-indices indices)
  ;; indices :: ((dispatch-key (op . backend-metadata) ...) ...) in any order;
  ;; reordered to the frozen backend_indices iteration order, each entry wrapped
  ;; as (key kernels device-guard?=#f) for the declaration emitters.
  (map (lambda (entry) (list (car entry) (cdr entry) #f))
       (sort indices
             (lambda (a b)
               (< (native-functions-backend-rank (car a))
                  (native-functions-backend-rank (car b)))))))

(define (get-native-function-declarations grouped backend-indices)
  ;; gen.py get_native_function_declarations: a list of LINES (no newlines) that
  ;; block-substitutes into the template.  There is a single in-tree namespace
  ;; ("at::native"), so the namespace prologue/epilogue are folded in directly;
  ;; the leading "" and trailing "        " mirror the f-string + split(newline)
  ;; and are dropped by the block-substitute.
  (let* ((kernels
          (append-map
           (lambda (f)
             (append-map (lambda (bi)
                           (compute-native-function-declaration f bi))
                         backend-indices))
           grouped))
         (ordered-kernels (delete-duplicates kernels string=?))
         (body (string-append
                "\nnamespace at {\nnamespace native {\n"
                (string-join ordered-kernels "\n")
                "\n} // namespace native\n} // namespace at\n        ")))
    (string-split body #\newline)))

(define %native-functions-template
  (string-append
   "#pragma once\n"
   "\n"
   "// ${generated_comment}\n"
   "\n"
   "#ifdef TORCH_ASSERT_NO_OPERATORS\n"
   "#error This change adds a dependency on native_functions.yaml,            \\\n"
   "  meaning the file will need to be re-compiled every time an operator     \\\n"
   "  is changed or added. Consider if your change would be better placed in  \\\n"
   "  another file, or if a more specific header might achieve the same goal. \\\n"
   "  See NOTE: [Tensor vs. TensorBase]\n"
   "#endif\n"
   "\n"
   "#if defined(AT_PER_OPERATOR_HEADERS) && defined(TORCH_ASSERT_ONLY_METHOD_OPERATORS)\n"
   "#error This change adds a dependency on all pytorch operators, meaning the      \\\n"
   "  file will need to be re-compiled every time an operator is changed or added.  \\\n"
   "  Consider including a specific operator from <ATen/ops/{my_operator}_native.h> \\\n"
   "  and see NOTE [TORCH_ASSERT_ONLY_METHOD_OPERATORS].\n"
   "#endif\n"
   "\n"
   "#include <c10/core/Scalar.h>\n"
   "#include <c10/core/Storage.h>\n"
   "#include <c10/core/TensorOptions.h>\n"
   "#include <c10/util/Deprecated.h>\n"
   "#include <optional>\n"
   "#include <c10/core/QScheme.h>\n"
   "#include <ATen/core/Reduction.h>\n"
   "#include <ATen/core/Tensor.h>\n"
   "#include <tuple>\n"
   "#include <vector>\n"
   "\n"
   "${NativeFunctions_includes}\n"
   "\n"
   "${NativeFunctions_declarations}\n"))

(define* (render-native-functions-h grouped indices
                                    #:key
                                    (includes '("#include <ATen/NativeMetaFunctions.h>"))
                                    (declarations #f))
  ;; indices :: ((dispatch-key (op . backend-metadata) ...) ...) in any order;
  ;; reordered to the frozen backend_indices iteration order.
  (let ((backend-indices (ordered-backend-indices indices)))
    (code-template-substitute
     %native-functions-template
     (lambda (key)
       (cond
        ((string=? key "generated_comment")
         (string-append "@generated by " %generator-path
                        " from NativeFunctions.h"))
        ((string=? key "NativeFunctions_includes") includes)
        ((string=? key "NativeFunctions_declarations")
         (or declarations
             (get-native-function-declarations grouped backend-indices)))
        (else (error 'unknown-template-key key)))))))

