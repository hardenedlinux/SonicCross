(define %native-meta-functions-template
  (string-append
   "#pragma once\n"
   "\n"
   "// ${generated_comment}\n"
   "\n"
   "#include <ATen/core/Tensor.h>\n"
   "#include <ATen/core/IListRef.h>\n"
   "#include <ATen/TensorMeta.h>\n"
   "#include <ATen/TensorIterator.h>\n"
   "\n"
   "${NativeMetaFunctions_includes}\n"
   "\n"
   "namespace at {\n"
   "\n"
   "namespace meta {\n"
   "\n"
   "${NativeMetaFunctions_declarations}\n"
   "\n"
   "} // namespace meta\n"
   "} // namespace at\n"))

;; torchgen api/meta.py name(): str(g.functional.func.name).replace(".", "_")
(define (structured-meta-name group)
  (string-replace-all
   (operator-name->string
    (function-schema-name
     (native-function-func (native-functions-group-functional group))))
   "." "_"))

;; One setter method of the precompute_out struct (compute_meta_function_declaration
;; precomputed branch).  `i` indexes the element being set; `elements` are the
;; precomputed Arguments, `with-types` their NamedCType translations, `params`
;; the upper-cased template parameter names.
(define (compute-precomputed-setter i elements with-types params)
  (let* ((elem (list-ref elements i))
         (nct (list-ref with-types i))
         (return-ty-templates
          (string-join
           (append (take params i) '("true") (drop params (1+ i)))
           ", "))
         (return-ty (string-append "precompute_out<" return-ty-templates ">"))
         (elem-cpp-ty (api:ctype-cpp-type (api:named-ctype-type nct) #t))
         (signature (string-append return-ty " set_" (argument-name elem)
                                   "(" elem-cpp-ty " value)"))
         (assert-msg (string-append "\"" (argument-name elem) " already set\""))
         (assert-stmt (string-append "static_assert(" (list-ref params i)
                                     " == false, " assert-msg ");"))
         (construction-stmts
          (cons (string-append return-ty " ret;")
                (append
                 (map (lambda (j elem2)
                        (if (= i j)
                            (string-append "ret." (argument-name elem2) " = value;")
                            (string-append "ret." (argument-name elem2)
                                           " = this->" (argument-name elem2) ";")))
                      (iota (length elements)) elements)
                 (list "return ret;"))))
         (construction-block (string-join construction-stmts "\n")))
    (string-append
     "\n"
     "                    " signature " {\n"
     "                        " assert-stmt "\n"
     "                        " construction-block "\n"
     "                    }\n"
     "                ")))

;; Returns (values precomputed-decl meta-return-typedef meta-return).
(define (compute-precomputed-decl precomputed)
  (call-with-values
      (lambda () (api:parse-precomputed precomputed))
    (lambda (replace add)
      (let* ((precomputed-values (append (map cdr replace) (list add)))
             (precomputed-elements (append-map identity precomputed-values))
             (template-params (map (lambda (e) (string-upcase (argument-name e)))
                                   precomputed-elements))
             (params-str (string-join
                          (map (lambda (p) (string-append "bool " p " = false"))
                               template-params)
                          ", "))
             (template-decl (string-append "template <" params-str ">"))
             (elements-with-types
              (map (lambda (e) (api:structured-argument-type e (argument-name e)))
                   precomputed-elements))
             (elements-decl
              (string-join
               (map (lambda (nct)
                      (string-append (api:ctype-cpp-type (api:named-ctype-type nct) #t)
                                     " " (api:named-ctype-name nct)))
                    elements-with-types)
               ";\n"))
             (setter-methods-decl
              (string-join
               (map (lambda (i)
                      (compute-precomputed-setter i precomputed-elements
                                                  elements-with-types
                                                  template-params))
                    (iota (length precomputed-elements)))
               "\n"))
             (meta-return-template-params
              (string-join (make-list (length template-params) "true") ", "))
             (meta-return-typedef
              (string-append "using meta_return_ty = precompute_out <"
                             meta-return-template-params ">;"))
             (precomputed-decl
              (string-append
               "\n"
               "                " template-decl "\n"
               "                struct TORCH_API precompute_out {\n"
               "                    " setter-methods-decl "\n"
               "                    " elements-decl ";\n"
               "            };")))
        (values precomputed-decl meta-return-typedef "meta_return_ty")))))

(define (compute-meta-function-declaration g)
  ;; g :: <native-functions-group>.  Returns the structured meta struct text, or
  ;; #f for a non-structured group (mapMaybe drops it).
  (if (not (native-functions-group-structured? g))
      #f
      (let* ((out (native-functions-group-out g))
             (name (structured-meta-name g))
             (args-str (string-join
                        (map api:binding-decl (api:structured-meta-arguments g))
                        ", "))
             (parent-class (or (native-function-structured-inherits out)
                               "at::impl::MetaBase"))
             (precomputed (native-function-precomputed out)))
        (call-with-values
            (lambda ()
              (if precomputed
                  (compute-precomputed-decl precomputed)
                  (values "" "" "void")))
          (lambda (precomputed-decl meta-return-typedef meta-return)
            (string-append
             "struct TORCH_API structured_" name " : public " parent-class " {\n"
             "    " precomputed-decl "\n"
             "    " meta-return-typedef "\n"
             "    " meta-return " meta(" args-str ");\n"
             "};\n"))))))

(define* (render-native-meta-functions-h structured
                                         #:key (includes '()) (declarations #f))
  ;; structured :: the structured native-functions groups, in order.
  (code-template-substitute
   %native-meta-functions-template
   (lambda (key)
     (cond
      ((string=? key "generated_comment")
       (string-append "@generated by " %generator-path
                      " from NativeMetaFunctions.h"))
      ((string=? key "NativeMetaFunctions_includes") includes)
      ((string=? key "NativeMetaFunctions_declarations")
       (or declarations (filter-map compute-meta-function-declaration structured)))
      (else (error 'unknown-template-key key))))))
