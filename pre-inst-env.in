#!/bin/sh

abs_top_srcdir="@abs_top_srcdir@"
abs_top_builddir="@abs_top_builddir@"

GUILE_LOAD_PATH="$abs_top_srcdir:$abs_top_srcdir/modules${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
GUILE_LOAD_COMPILED_PATH="$abs_top_builddir:$abs_top_builddir/modules${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
export GUILE_LOAD_PATH GUILE_LOAD_COMPILED_PATH

exec "$@"
